    "def _get_zone(hhmm):\n",
    "    \"\"\"Return which session zone a time falls in, or None if between zones.\"\"\"\n",
    "    for zone, (start, end) in SESSION_ZONES.items():\n",
    "        if start <= hhmm < end:\n",
    "            return zone\n",
    "    return None\n",
